PALPATE_DATABASE_URL=postgresql://palpate:palpate@localhost:5432/palpate
PALPATE_AWS_REGION=us-east-1

# Bedrock model IDs: copy them from the Bedrock console (model access must be enabled).
# Leave a model id empty to keep that provider unconfigured.
PALPATE_ANSWER_MODEL_ID=
PALPATE_BULK_MODEL_ID=
PALPATE_EMBEDDING_MODEL_ID=cohere.embed-multilingual-v3
PALPATE_EMBEDDING_DIM=1024
PALPATE_VISION_MODEL_ID=

# Speech-to-text: empty, "none", or "transcribe" (Amazon Transcribe adapter is stubbed).
PALPATE_STT_PROVIDER=
PALPATE_STT_MODEL_ID=

# pgvector uses Postgres. memory keeps the index in-process (tests and the offline sample).
PALPATE_VECTOR_STORE=pgvector
# PALPATE_FIGURES_DIR=
